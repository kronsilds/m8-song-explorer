{
  "name": "m8-song-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5176",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test tests",
    "preview": "vite preview --port 4176",
    "lint": "biome lint .",
    "format": "biome check --write . && bun scripts/alignObjects.ts src tests scripts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@yam8d/m8-sdk": "^0.5.2",
    "post-me": "^0.4.5",
    "three": "0.186.1",
    "troika-three-text": "0.52.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
